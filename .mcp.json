{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--isolated",
        "--device",
        "Pixel 7",
        "--console-level",
        "warning",
        "--output-dir",
        ".loop/artifacts",
        "--allowed-origins",
        "http://localhost:5174;http://127.0.0.1:5174;http://localhost:5173;http://127.0.0.1:5173;http://localhost:3101;http://127.0.0.1:3101"
      ]
    }
  }
}
