DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dhobi_matrimony?schema=public
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_jwt_secret_here
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
ADMIN_JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@dhobimatrimony.com
ADMIN_PASSWORD=Test@123
ADMIN_NAME=Admin User

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_PHOTOS=dhobi-matrimony-photos
AWS_S3_BUCKET_DOCUMENTS=dhobi-matrimony-documents-private

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# App
PORT=3000
NODE_ENV=development
